APP_SECRET_KEY=change-me
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=0

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
# 修改为运行电脑自己的 MySQL 账号、密码和数据库名。
# MYSQL_PASSWORD 为空密码时留空：MYSQL_PASSWORD=
# MYSQL_DATABASE 可以自定义，python init_db.py 会按这里的名称创建并初始化数据库。
MYSQL_USER=root
MYSQL_PASSWORD=123456
MYSQL_DATABASE=SFweb

UDP_BIND_HOST=0.0.0.0
UDP_BIND_PORT=8080
UDP_SEND_PORT=8081
UDP_ENCODING=gb2312
UDP_COMMAND_SUFFIX=\r\n
UDP_RECV_SIZE=8192
UDP_IMAGE_TIMEOUT_SECONDS=30

AI_UPLOAD_ROOT=static/uploads/ai
AI_CLASS_MODEL_PATH=models/fish_disease_cls.pt
AI_DETECT_MODEL_PATH=models/fish_disease_det.pt
AI_ALARM_CONFIDENCE=0.75
AI_MODEL_IMG_SIZE=640
ROBOFLOW_API_KEY=
